# 🔐 Security Configuration
# Set your secure, private API key below (REQUIRED)
API_KEY=your_strong_secret_key_here

# Optional: Flask session secret key (if omitted, auto-derived from API_KEY)
# SESSION_SECRET=your_random_session_secret_here

# 🌐 SSL / TLS Verification (default: true)
VERIFY_SSL=true

# ⚙️ Release & Protocol Settings
# Note: TSun internal binary protobuf payload is compiled for OB53 (1.114.13)
RELEASE_VERSION=OB53

# ⚙️ Auto-refill Settings
AUTO_REFILL=true
MIN_TOKEN_THRESHOLD=5
DEFAULT_REFILL_AMOUNT=10

