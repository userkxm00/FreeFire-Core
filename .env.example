# 🔐 Security Configuration
# Set your secure, private API key below (REQUIRED)
API_KEY=your_strong_secret_key_here

# 🔑 Flask Session Secret Key (REQUIRED FOR PRODUCTION)
# Generate a cryptographically strong 64-hex random secret (e.g. python -c "import secrets; print(secrets.token_hex(32))")
# If omitted in development, an ephemeral in-memory random secret is generated on boot.
SESSION_SECRET=your_independent_random_session_secret_here

# 🍪 Cookie Security Flag (true = HTTPS only; false = HTTP dev)
# Automatically enables true in production / Vercel if omitted.
COOKIE_SECURE=false

# 🌐 SSL / TLS Verification (default: true)
VERIFY_SSL=true

# ⚙️ Release & Protocol Settings
# Note: TSun internal binary protobuf payload is compiled for OB53 (1.114.13)
RELEASE_VERSION=OB53

# ⚙️ Auto-refill Settings
AUTO_REFILL=true
MIN_TOKEN_THRESHOLD=5
DEFAULT_REFILL_AMOUNT=10
